*/Manifest.toml
/Manifest*.toml
!experiments/Manifest.toml
.vscode

# Maintainer notes, logs and coverage output
/notes/
*.err
*.out
*.log
*.cov
lcov.info

# Documentation build output and the tutorials Literate renders from examples/
/docs/build/
/docs/src/tutorials/

# Figures and data produced by experiment runs
experiments/**/*.png
experiments/**/*.svg
experiments/**/*.pdf
experiments/**/*.jld2

# Small collections and masks of fai_benchmarks/ only; the data of paper/ are archived on Zenodo
# (experiments/README.md, "Data")
!experiments/fai_benchmarks/**/collected_results.jld2
!experiments/fai_benchmarks/**/masks.jld2
# Discrete floor quoted in Sec. 5.1 of the paper, see experiments/paper/README.md
!experiments/paper/anisotropy_floor/discrete_floor.jld2
# Notes the paper plotters write next to their figures (archived on Zenodo with the data)
experiments/paper/**/plots_paper*/

experiments/**/logs/
experiments/**/tasks/
!experiments/**/maskplots/*.png

**/finaldata/
