    family-names: Torrente
  - given-names: Stefano
    family-names: Carignano
  - given-names: Artur
    family-names: Garcia
  - given-names: Daniel
    family-names: Pérez García
version: 0.1.0
license: MIT
repository-code: "https://github.com/bsc-quantic/DifferenTT.jl"
url: "https://bsc-quantic.github.io/DifferenTT.jl/"
keywords:
  - tensor trains
  - matrix product states
  - quantized tensor trains
  - partial differential equations
  - preconditioning
  - factorized approximate inverse
  - Julia
preferred-citation:
  type: article
  title: Factorized approximate inverse preconditioners in the tensor train format
  status: in-preparation
